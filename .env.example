# ============================================================
# Groq API Configuration (Required for STT, Vision, and LLM)
# Get your key at: https://console.groq.com/keys
# ============================================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# ============================================================
# Qdrant Vector Database (Required for Hybrid Multimodal RAG)
# Get cloud cluster at: https://cloud.qdrant.io/
# ============================================================
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ============================================================
# Neon PostgreSQL Checkpointer (Persistent Chat History)
# Get database URL at: https://neon.tech
# If omitted, automatically falls back to local SQLite (chatbot.db)
# ============================================================
POSTGRES_URI=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================
# Neon Auth (Managed Better Auth / EdDSA JWT verification)
# From Neon Console -> Settings -> Auth
# ============================================================
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neon-auth.com

# ============================================================
# Alpha Vantage (Required for get_stock_price tool)
# Get free key at: https://www.alphavantage.co/support/#api-key
# ============================================================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================================
# Optional Configurations
# ============================================================
# Comma-separated list of whitelisted user emails (empty allows all authenticated users)
ALLOWED_EMAILS=

# Voice for Edge-TTS synthesizer (e.g., en-IN-PrabhatNeural, en-US-AriaNeural, en-GB-RyanNeural, hi-IN-SwaraNeural)
AGENT_VOICE=en-IN-PrabhatNeural

# CORS Allowed Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# Server Port
PORT=8000
